# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
.env
bin/
include/
lib/
share/
pyvenv.cfg

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST

# Testing / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/
.virtual_documents/
*-checkpoint.ipynb
Untitled*.ipynb

# Datasets: regenerated on demand by torchvision / the simulated designs.
# Never commit these -- 63MB of MNIST idx binaries is what bloated the history.
data/

# Experiment outputs. Each run is reproducible from its config + seed, so the
# artifacts do not belong in git. Commit the config, not the result.
results/
# ...but keep the directory itself so the runner has somewhere to write.
!results/.gitkeep

# Scratch plots. Figures for the writeup belong in the thesis document repo,
# or are regenerated by `python -m experiments.run`.
plots/

# Literature PDFs. Copyrighted, and one is an unpublished manuscript -- this
# repo is public. notes/ref.bib carries titles, authors, and
# arXiv IDs, which is enough to find any of them.
lit/*.pdf

# OS
.DS_Store
**/.DS_Store
Thumbs.db

# Claude Code per-machine settings (settings.json is shared, .local.json is not)
.claude/settings.local.json

# Editors
.vscode/
.idea/
*.swp
